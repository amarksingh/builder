{
    "name": "@ostro/builder",
    "version": "2.0.0-alpha.4",
    "description": "Unified TypeScript build tool and non-TS asset synchronizer for OstroJS ecosystem",
    "main": "index.js",
    "types": "types/index.d.ts",
    "bin": {
        "ostro-builder": "bin.js",
        "ostro-build": "bin.js"
    },
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./index.js"
        },
        "./*": {
            "types": "./types/*.d.ts",
            "default": "./*.js"
        }
    },
    "scripts": {
        "test": "npx c8 npx jest",
        "build": "npm run lint:check && rm -rf build && npx tsc -p tsconfig.build.json && npx ts-node scripts/build.ts",
        "prepublishOnly": "npm run build",
        "clean": "rm -rf build coverage",
        "lint:check": "tsc --noEmit -p tsconfig.build.json"
    },
    "dependencies": {},
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "ostrojs",
        "builder",
        "compiler",
        "assets"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/builder.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/builder/issues"
    },
    "homepage": "https://github.com/ostrojs/builder#readme",
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "c8": "^10.1.3",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.0"
    }
}
